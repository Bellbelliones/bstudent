.board ol { list-style: none; margin: 0; padding: 0; }
.board li { display: grid; grid-template-columns: 6.5rem 1fr auto; gap: .75rem; align-items: center; padding: .7rem 0; border-top: 1px solid #ffffff2e; }
.board__date { color: #b9c8d6; font-size: .88rem; }
.board a { color: #fff; text-decoration: none; font-weight: 600; }
.board a:hover { text-decoration: underline; }
.board small { display: block; color: #b9c8d6; font-weight: 400; }
.board__msg { color: #b9c8d6; }
.steps { padding: 3rem 0; }
.steps ol { display: grid; gap: 1.5rem; padding: 0; margin: 0; list-style: none; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); counter-reset: s; }
.steps li { counter-increment: s; border-top: 3px solid var(--ink); padding-top: .75rem; }
.steps h3::before { content: counter(s) ". "; color: var(--teal); }